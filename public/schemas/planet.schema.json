{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likeUMR.github.io/astra-universe/schemas/planet.schema.json",
  "title": "Astra Planet 0.1",
  "type": "object",
  "required": ["protocol", "name", "entry", "seed", "radius", "previewColor"],
  "properties": {
    "protocol": { "const": "astra-planet/0.1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "entry": { "const": "planet.js" },
    "seed": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "radius": { "type": "number", "minimum": 100, "maximum": 5000 },
    "previewColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
